# Postgres / Redis (used by api + worker, hostnames are docker-compose service names)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/wp2
REDIS_URL=redis://redis:6379/0

# External APIs (added in later steps; safe to leave blank for step 1)
OPENAI_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit recommends format `<platform>:<app-id>:<version> (by /u/<username>)`.
# Generic-looking user-agents are flagged by their bot detection.
REDDIT_USER_AGENT=script:wp2-leadfinder:0.1 (by /u/CHANGE_ME)
